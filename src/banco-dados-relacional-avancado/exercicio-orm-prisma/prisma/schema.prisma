// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id String @db.Uuid @id @default(uuid())
  nome String @db.VarChar(120)
  email String @db.VarChar(120) @unique

  projetos UsuarioProjeto[]

  dtcriacao DateTime @default(now()) @map("dt_criacao")
  dtAtualizacao DateTime @updatedAt @map("dt_atualizacao")

  @@map("usuario")
}

model UsuarioProjeto {
  idUsuario String @db.Uuid @map("id_usuario")
  idProjeto String @db.Uuid @map("id_projeto")

  usuarios Usuario @relation(fields: [idUsuario], references: [id])
  projetos Projeto @relation(fields: [idProjeto], references: [id])

  dtcriacao DateTime @default(now()) @map("dt_criacao")
  dtAtualizacao DateTime @updatedAt @map("dt_atualizacao")

  @@id([idUsuario, idProjeto])
  @@map("usuario_projeto")
}

model Projeto {
  id String @id @default(uuid())
  titulo String @db.VarChar(120)
  descricao String @db.VarChar(300)
  prazoConclusao DateTime? @map("prazo_conclusao")

  tarefas Tarefa[]
  usuarios UsuarioProjeto[]
  
  dtcriacao DateTime @default(now()) @map("dt_criacao")
  dtAtualizacao DateTime @updatedAt @map("dt_atualizacao")

  @@map("projeto")
}

model Tarefa {
  id String @id @default(uuid())
  titulo String @db.VarChar(120)
  descricao String @db.VarChar(300)
  horas Int @db.SmallInt
  urgente Boolean @default(false)

  idProjeto String @map("id_projeto") 
  projeto Projeto @relation(fields: [idProjeto], references: [id])

  dtcriacao DateTime @default(now()) @map("dt_criacao")
  dtAtualizacao DateTime @updatedAt @map("dt_atualizacao")

  @@map("tarefa")
}

